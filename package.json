{
  "name": "metawall-backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "start:dev": "node --env-file-if-exists=config.env --watch ./bin/www",
    "start:production": "node --env-file-if-exists=config.env ./bin/www",
    "swagger": "node ./swagger.js",
    "test": "node --test tests/*.test.js",
