  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.0.1",
    "express": "4.22.3",
    "imgur": "2.6.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "6.13.11",
    "morgan": "1.12.1",
    "multer": "^1.4.5-lts.1",
    "sharp": "0.35.5",
    "swagger-autogen": "^2.21.2",
    "swagger-ui-express": "^4.4.0",
    "tslib": "^2.4.0",
    "validator": "13.15.35"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "10.4.3",
    "supertest": "7.3.1"
  },
  "engines": {
    "node": "22.x"
  }
